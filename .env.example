# Core
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# optional: fast command reg in dev
DISCORD_GUILD_ID_DEV=

# Database
DATABASE_PATH=./data/ratpack.db

# Lavalink
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# Optional: Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Apple Music
APPLE_MUSIC_TOKEN=

# Optional: Deezer / Tidal
DEEZER_KEY=
TIDAL_KEY=

# YouTube resilience — without one of these, expect "All clients failed to
# load the item" once YouTube's bot detection kicks in (it usually does,
# even on residential IPs). OAuth is the more complete fix (poToken only
# covers the WEB/WEBEMBEDDED clients per the plugin's own docs):
#   1. Set YOUTUBE_OAUTH_ENABLED=true and restart the lavalink container
#   2. Watch `docker compose logs -f lavalink` for a one-time URL + code
#   3. Visit it, sign in (use a burner Google account — the plugin's own
#      docs warn this can get an account flagged/terminated), authorize
#   4. Lavalink prints a refresh token once, after success — copy it into
#      YOUTUBE_REFRESH_TOKEN below and restart, so it's not needed again
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
# Alternative/complementary to OAuth
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Optional: Steam (free key from steamcommunity.com/dev/apikey) — needed for
# /steam profile lookups AND /news (Valve retired the keyless catalog
# endpoint the build plan assumed /news could run without)
STEAM_API_KEY=

# Optional: Riot (Valorant static data works without it; live match/rank
# lookup needs production API access beyond a basic dev key, so /stats
# valorant stays static-only for now regardless of this)
RIOT_API_KEY=

# Optional: Fortnite (free key from dash.fortnite-api.com — the build plan
# assumed no key was needed for stats, but fortnite-api.com requires one)
FORTNITE_API_KEY=

# Optional: DBD perks/character data — no confirmed stable public host was
# found for the plan's "DBD-Database" API, so this is unset by default and
# /stats dbd degrades gracefully until you point it at a working instance
DBD_API_BASE_URL=

# Optional: folder Peaches looks in for image/gif/video overrides, e.g.
# angry.png or hole.gif — falls back to built-in defaults for anything
# not found here. Defaults to ./data/peaches-images
PEACHES_IMAGE_DIR=

# Behavior
LOG_LEVEL=info
FLAVOR_ENABLED=true
