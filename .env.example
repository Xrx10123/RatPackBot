# Core
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# optional: fast command reg in dev
DISCORD_GUILD_ID_DEV=

# Database
DATABASE_PATH=./data/ratpack.db

# Lavalink
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# Optional: Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Apple Music
APPLE_MUSIC_TOKEN=

# Optional: Deezer / Tidal
DEEZER_KEY=
TIDAL_KEY=

# Optional: YouTube resilience
YOUTUBE_COOKIE=
YOUTUBE_PO_TOKEN=

# Optional: Steam (free key from steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Optional: Riot (for Valorant match history)
RIOT_API_KEY=

# Optional: Project Zomboid RCON
ZOMBOID_RCON_HOST=
ZOMBOID_RCON_PORT=
ZOMBOID_RCON_PASSWORD=

# Behavior
LOG_LEVEL=info
FLAVOR_ENABLED=true
